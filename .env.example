# ==========================================
# FeatureOS Environment Variables Template
# ==========================================

NODE_ENV=development

# ------------------------------------------
# PostgreSQL & Prisma
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=featureos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/featureos?schema=public"

# ------------------------------------------
# Redis Cache & Pub/Sub
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ------------------------------------------
# Apache Kafka
# ------------------------------------------
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID=featureos-api
KAFKA_GROUP_ID=featureos-workers

# ------------------------------------------
# ClickHouse Analytics
# ------------------------------------------
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=featureos_analytics

# ------------------------------------------
# Express API (apps/api)
# ------------------------------------------
PORT=4000
API_URL="http://localhost:4000"
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS="http://localhost:3000"

# ------------------------------------------
# Next.js Dashboard (apps/web)
# ------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_GRAPHQL_URL="http://localhost:4000/graphql"
NEXT_PUBLIC_SSE_URL="http://localhost:4000/api/v1/stream"

# ------------------------------------------
# FastAPI AI Service (apps/ai-service)
# ------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_URL="http://localhost:8000"
OPENAI_API_KEY=mock-openai-key-or-sk-proj-key
MODEL_NAME=gpt-4o-mini
